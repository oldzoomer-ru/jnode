# ============================================================
# jNode Docker Environment Configuration
# Copy this file to .env and adjust values
# ============================================================

# --- Timezone ---
TZ=Europe/Moscow

# --- Java Memory ---
JNODE_XMS=128m
JNODE_XMX=512m

# --- Java Additional Options ---
JNODE_OPTS=-Djava.awt.headless=true -Dfile.encoding=UTF-8

# --- Database ---
# Default: H2 (embedded, no extra service needed)
# For PostgreSQL: uncomment and set values
# DB_TYPE=postgres
# POSTGRES_DB=jnode
# POSTGRES_USER=jnode
# POSTGRES_PASSWORD=change_me_secure_password

# For MySQL: uncomment and set values
# DB_TYPE=mysql
# MYSQL_DATABASE=jnode
# MYSQL_USER=jnode
# MYSQL_PASSWORD=change_me_secure_password

# --- Ports ---
# BinkP port (FTN bundle exchange)
BINKP_PORT=24554
# HTTPD port (web interface)
HTTPD_PORT=8080

# --- Node Configuration ---
# Node address (2:9999/9999 format)
NODE_ADDRESS=2:9999/9999
NODE_NAME=My FTN Node
SYSOP_NAME=SysOp
